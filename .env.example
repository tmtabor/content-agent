# Copy to .env and fill in your values.
# Provider API keys keep their standard names (the provider SDKs read them
# directly); agent-specific settings use the AGENT_ prefix to avoid clashing
# with generic shell variables like MODEL. Set the key for whichever provider
# AGENT_MODEL points at — any provider pydantic-ai supports works here, not
# just the ones listed below; Settings validates it by asking pydantic-ai to
# build that provider at import time.

# Default model: gemma4 via a local Ollama install — no API key needed, but
# OLLAMA_BASE_URL must be set. Must include the /v1 suffix — Ollama only
# serves its OpenAI-compatible API there. Omitting it passes config
# validation but 404s on the first generation call.
OLLAMA_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=ollama:gemma4

# Only needed if you switch AGENT_MODEL to a hosted provider instead:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Judge model for LLM-as-judge evals (default: anthropic:claude-opus-4-8)
# AGENT_JUDGE_MODEL=anthropic:claude-opus-4-8

# Logfire observability (optional — console output used if not set)
# LOGFIRE_TOKEN=your_logfire_token_here

# Logging level (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# SQLite file holding all brand config + content history (default: content_agent.db)
# AGENT_DB_PATH=content_agent.db

# Required to use "Send to SkyPilot" from the Bluesky agent.
# https://skypilot.social/static/html/api.html
SKYPILOT_API_KEY=your_skypilot_api_key_here
